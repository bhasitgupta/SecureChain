{
  "name": "sih26125",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "build": "npm --workspace frontend run build",
    "dev": "npm --workspace frontend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace services/gateway run dev",
    "dev:workers": "npm --workspace services/workers run dev",
    "dev:indexer": "npm --workspace services/indexer run dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "solc": "^0.8.20",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "vite": "^8.3.0"
  }
}
