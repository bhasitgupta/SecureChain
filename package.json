{
  "name": "sih26125",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "build": "cd frontend && npm run build",
    "dev": "npm --workspace frontend run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "dev:backend": "npm --workspace services/gateway run dev",
    "dev:workers": "npm --workspace services/workers run dev",
    "dev:indexer": "npm --workspace services/indexer run dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "onchain:status": "node scripts/onchain-status.mjs",
    "onchain:bootstrap": "node scripts/bootstrap-onchain.mjs",
    "onchain:smoke": "node scripts/onchain-smoke.mjs"
  },
  "devDependencies": {
    "solc": "^0.8.20",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "vite": "^8.3.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.28.2"
  },
  "allowScripts": {
    "esbuild": true
  }
}
