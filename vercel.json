{
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "vite"
        },
        "gateway": {
            "root": "services/gateway"
        }
    },
    "rewrites": [
        {
            "source": "/api(/.*)?",
            "destination": {
                "type": "service",
                "service": "gateway"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "type": "service",
                "service": "frontend"
            }
        }
    ]
}
